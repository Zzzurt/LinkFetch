<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：默认禁止明文流量。

  背景：App 在「自建服务器模式」下会把 X-API-Token 与三平台 Cookie 作为请求头发给后端。
  若允许明文，同一网络下的任何设备都能嗅探到这些账号级凭证，因此公网地址一律强制 HTTPS。

  例外只给本机回环与模拟器宿主机；如需通过局域网 http 访问自建服务，
  按下方注释的格式把内网地址加进白名单（明文风险由使用者自行判断）。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 本机调试：模拟器宿主机与回环地址 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!--
      平台媒体 CDN：平台下发的媒体资源地址（图片 / 视频 / Live 动态图）可能为 http。
      这些地址不带账号凭证（媒体文件本身），放行明文只影响媒体下载，不影响后端 Token/Cookie 等
      凭证的明文传输（那些仍被 base-config 强制 HTTPS）。名单与 MediaDownloader.headersFor
      的覆盖一致，避免「图片存得下、Live/视频存不下」这类同类问题反复出现。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">xhscdn.com</domain>
        <domain includeSubdomains="true">xhsimg.com</domain>
        <domain includeSubdomains="true">weibocdn.com</domain>
    </domain-config>

    <!--
      局域网自建服务示例：把 192.168.1.8 换成你的服务器地址后取消注释即可。
      <domain-config cleartextTrafficPermitted="true">
          <domain includeSubdomains="false">192.168.1.8</domain>
      </domain-config>
    -->
</network-security-config>
