<resources>
    <style name="Theme.LinkFetch" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <!-- 浅色模式下使用深色状态栏图标，保证白色背景上清晰可见 -->
        <item name="android:windowLightStatusBar">true</item>
        <!--
          windowLightNavigationBar 需要 API 27（Android 8.1），而 minSdk 为 26，
          因此该属性声明在 values-v27/themes.xml；API 26 上系统不支持浅色导航栏，
          属性本就会被忽略，此处不写以避免 lint 报 NewApi。
        -->
    </style>

    <!--
      启动主题：Android 12+ 用系统 SplashScreen，低版本由 core-splashscreen 兼容。
      图标复用桌面图标（墨底白链），浅色/深色启动背景上都能看清。
    -->
    <style name="Theme.LinkFetch.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.LinkFetch</item>
    </style>
</resources>
